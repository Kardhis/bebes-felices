# Frontend (copiar a apps/web/.env.local para desarrollo)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend
APP_SITE_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Amazon Creators API (opcionales; no incluir secretos reales en Git)
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
AMAZON_CREATORS_PARTNER_TAG=
